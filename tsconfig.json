{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Note: inlined from @docusaurus/tsconfig (minus the TS7-removed baseUrl option)
  // so the config stays compatible with both TypeScript 6 and 7.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [
    ".docusaurus",
    "node_modules",
    "build"
  ]
}
